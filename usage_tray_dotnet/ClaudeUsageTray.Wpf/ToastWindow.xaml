<Window x:Class="ClaudeUsageTray.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Grid Margin="18">
        <Border x:Name="RootBorder" CornerRadius="14" MouseLeftButtonUp="OnClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.22" Color="Black" />
            </Border.Effect>
            <StackPanel x:Name="ContentHost" Orientation="Horizontal" Margin="16,14" />
        </Border>
    </Grid>
</Window>
