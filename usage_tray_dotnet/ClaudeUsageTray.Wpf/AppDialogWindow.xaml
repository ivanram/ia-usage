<Window x:Class="ClaudeUsageTray.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <!--
    A native MessageBox always renders as a light Windows dialog no matter
    what theme the app is in — jarring dropped into an otherwise dark UI.
    This is the same borderless rounded-Border-with-shadow shape as the
    popup/toast windows, but built from MaterialDesignPaper/Body so it
    actually follows the app's current theme.
    -->
    <Window.Resources>
        <Style x:Key="PrimaryDialogButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryDialogButton" TargetType="Button" BasedOn="{StaticResource PrimaryDialogButton}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="14" Padding="24" MinWidth="320" MaxWidth="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <!--
                Borderless/topmost/ShowInTaskbar=False means this dialog has
                no native title bar and no taskbar entry to identify it by —
                without something branded inside the content itself, a user
                who isn't looking straight at the screen when it pops up has
                no way to tell which app is asking. Shown unconditionally,
                independent of whatever TitleText says for this particular
                dialog.
                -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Image x:Name="AppIcon" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="AppNameText" FontSize="12" FontWeight="Medium" Opacity="0.65"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Medium"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock x:Name="MessageText" FontSize="13"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           TextWrapping="Wrap" LineHeight="19" />
                <ScrollViewer x:Name="ChangelogScroll" MaxHeight="200" Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <TextBlock x:Name="ChangelogText" FontSize="12.5"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               TextWrapping="Wrap" LineHeight="18" Opacity="0.8" />
                </ScrollViewer>
                <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="NoButton" Content="No" Width="100" Height="36" Margin="0,0,10,0"
                            Click="OnNoClick" Style="{StaticResource SecondaryDialogButton}" />
                    <Button x:Name="LaterButton" Content="Hoy no, mañana" Width="130" Height="36" Margin="0,0,10,0"
                            Visibility="Collapsed" Click="OnLaterClick" Style="{StaticResource SecondaryDialogButton}" />
                    <Button x:Name="YesButton" Content="Sí" Width="100" Height="36"
                            Click="OnYesClick" Style="{StaticResource PrimaryDialogButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
