<Window x:Class="ClaudeUsageTray.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual">
    <!--
    The extra Grid margin below is not decorative padding — it's room for
    the DropShadowEffect to fade out fully before hitting the window's own
    rectangular bounds. AllowsTransparency windows clip hard at their edge;
    without this margin the shadow's blur gets cut into a hard rectangle
    right past the rounded corners, which is exactly what read as "square
    corners still visible" on a window that's supposedly rounded.
    -->
    <Grid Margin="18">
        <Border x:Name="RootBorder" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.22" Color="Black" />
            </Border.Effect>
            <StackPanel x:Name="ContentHost" Margin="20" />
        </Border>
    </Grid>
</Window>
