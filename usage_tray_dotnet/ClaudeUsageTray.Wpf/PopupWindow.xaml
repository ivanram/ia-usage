<Window x:Class="ClaudeUsageTray.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual">
    <!--
    The extra Grid margin below is not decorative padding — it's room for
    the DropShadowEffect to fade out fully before hitting the window's own
    rectangular bounds. AllowsTransparency windows clip hard at their edge;
    without this margin the shadow's blur gets cut into a hard rectangle
    right past the rounded corners, which is exactly what read as "square
    corners still visible" on a window that's supposedly rounded.
    -->
    <Grid x:Name="RootGrid" Margin="18">
        <Border x:Name="RootBorder" CornerRadius="16" MouseLeftButtonDown="OnRootMouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.22" Color="Black" />
            </Border.Effect>
            <!--
            Centered rather than the default Stretch: RootBorder itself is
            sized to the window's real (HWND) bounds, which in Blur mode is
            deliberately bigger than this content's natural size (see
            PopupWindow.ChromeReserve in the code-behind) so the acrylic
            tint/rounding covers the whole HWND without a gap. Centering
            this inner Grid keeps the actual content pinned at its natural
            size and lets that extra room appear as an even ring on all
            four sides instead of all piling up at the bottom (a StackPanel
            given more height than it needs only ever leaves the surplus
            below its last child, never distributes it).
            -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="ContentHost" Margin="20" />

                <!--
                A plain bar-chart *emoji* here (as originally tried) turned
                out to be invisible in light mode — most emoji fonts render
                this one as pale/white bars, which read fine on the popup's
                dark background but vanish on the light one, and being a
                genuine color-emoji glyph it ignores any Foreground we set
                (confirmed: PinButton's own re-coloring code below has no
                effect on emoji color glyphs, only on plain vector shapes).
                Drawn as three plain Rectangles instead, so it can actually
                be recolored per-theme the same way everything else here is.
                -->
                <Button x:Name="StatsButton" Width="26" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,72,0" Cursor="Hand"
                        Click="OnStatsClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="StatsBg" CornerRadius="13" Background="Transparent">
                                <Grid Width="14" Height="12">
                                    <Rectangle x:Name="StatsBar1" Width="3" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                                    <Rectangle x:Name="StatsBar2" Width="3" Height="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                                    <Rectangle x:Name="StatsBar3" Width="3" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="StatsBg" Property="Background" Value="#14808080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--
                Only meaningful while pinned (an unpinned panel already
                closes itself the moment the cursor leaves), so it's hidden
                the rest of the time — Visibility="Hidden", not Collapsed,
                so it keeps its fixed margin slot and neither sibling button
                ever shifts position when it appears/disappears.
                -->
                <Button x:Name="CloseButton" Width="26" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,104,0" Cursor="Hand" Visibility="Hidden"
                        Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBg" CornerRadius="13" Background="Transparent">
                                <TextBlock x:Name="CloseGlyph" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBg" Property="Background" Value="#14808080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--
                Pinning stops the away-hide timer (see TrayOrchestrator) from
                closing the panel, so it can be left open/moved around
                instead of vanishing the moment the cursor leaves it.
                -->
                <ToggleButton x:Name="PinButton" Width="26" Height="26"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,8,8,0" Cursor="Hand"
                              Checked="OnPinToggled" Unchecked="OnPinToggled">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" CornerRadius="13" Background="Transparent">
                                <TextBlock x:Name="Glyph" Text="&#128204;" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#14808080" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Glyph" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="-40" CenterX="7" CenterY="7" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!--
                Real Material Symbols glyphs (collapse_content / expand_content
                — path data fetched from fonts.gstatic.com), drawn as a Path
                rather than a font codepoint so it recolors per-theme exactly
                like StatsButton's bars. Which geometry is showing and its
                fill are both set in code (see UpdateCompactGlyph) since a
                plain XAML trigger can't swap Path.Data between two
                Geometry-typed values as cleanly as just setting it directly.
                -->
                <ToggleButton x:Name="CompactButton" Width="26" Height="26"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,8,40,0" Cursor="Hand"
                              Checked="OnCompactToggled" Unchecked="OnCompactToggled">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="CompactBg" CornerRadius="13" Background="Transparent">
                                <!--
                                Material Symbols path data lives in a 0..960 /
                                -960..0 coordinate space (icon drawn "hanging"
                                above y=0), not 0..24 — Stretch="None" (a
                                Path's default) draws it at those native
                                coordinates verbatim, which sits entirely
                                outside this 15x15 box and never gets painted.
                                Stretch="Uniform" directly on the Path itself
                                is what actually normalizes it into its own
                                render bounds; the Viewbox on top of that is
                                just the usual size-to-pixels step.
                                -->
                                <Viewbox Width="15" Height="15" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="CompactIconPath" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CompactBg" Property="Background" Value="#14808080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>
