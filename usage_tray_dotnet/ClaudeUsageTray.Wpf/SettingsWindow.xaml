<Window x:Class="ClaudeUsageTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ajustes"
        Width="760" Height="640"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24">
            <WrapPanel x:Name="CardHost" Orientation="Horizontal" />
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                <Button x:Name="CancelButton" Content="Cancelar" Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Width="110" Margin="0,0,10,0" Click="OnCancelClick" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Guardar" Style="{DynamicResource MaterialDesignRaisedButton}"
                        Width="110" Click="OnSaveClick" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
